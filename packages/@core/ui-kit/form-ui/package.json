{
  "name": "@vben-core/form-ui",
  "version": "5.8.0",
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "packages/@vben-core/uikit/form-ui"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "typecheck": "vue-tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "production": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "dependencies": {
    "@tanstack/store": "^0.11.2",
    "@tanstack/vue-form": "^1.33.5",
    "@vben-core/composables": "5.8.0",
    "@vben-core/icons": "5.8.0",
    "@vben-core/shadcn-ui": "5.8.0",
    "@vben-core/shared": "5.8.0",
    "@vben-core/typings": "5.8.0",
    "@vueuse/core": "^15.0.0",
    "vue": "3.5.41",
    "zod": "^4.4.3",
    "zod-defaults": "^0.2.3"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "element-plus": "^2.14.3",
    "unplugin-vue": "^8.0.1"
  }
}
