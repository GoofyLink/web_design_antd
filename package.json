{
  "name": "vben-admin-monorepo",
  "version": "5.7.0",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "vben",
    "vben admin",
    "vben pro",
    "vue",
    "vue admin",
    "vue vben admin",
    "vue vben admin pro",
    "vue3"
  ],
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": "vbenjs/vue-vben-admin.git",
  "license": "MIT",
  "author": {
    "name": "vben",
    "email": "ann.vben@gmail.com",
    "url": "https://github.com/anncwb"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "npm install",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo run build",
    "build:analyze": "turbo run build:analyze",
    "build:antd": "npm run build -- --filter=@vben/web-antd",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:docs": "npm run build -- --filter=@vben/docs",
    "build:ele": "npm run build -- --filter=@vben/web-ele",
    "build:naive": "npm run build -- --filter=@vben/web-naive",
    "build:tdesign": "npm run build -- --filter=@vben/web-tdesign",
    "build:play": "npm run build -- --filter=@vben/playground",
    "changeset": "changeset",
    "check": "npm run check:circular && npm run check:dep && npm run check:type && npm run check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:antd": "npm run dev --workspace=@vben/web-antd",
    "dev:antdv-next": "npm run dev --workspace=@vben/web-antdv-next",
    "dev:docs": "npm run dev --workspace=@vben/docs",
    "dev:ele": "npm run dev --workspace=@vben/web-ele",
    "dev:naive": "npm run dev --workspace=@vben/web-naive",
    "dev:tdesign": "npm run dev --workspace=@vben/web-tdesign",
    "dev:play": "npm run dev --workspace=@vben/playground",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "turbo run stub",
    "prepare": "is-ci || node scripts/prepare.mjs",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "npm run clean -- --del-lock && npm install",
    "test:benchmark": "vitest bench --run",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "changeset version && npm install"
  },
  "dependencies": {},
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@tsdown/css": "0.22.14",
    "@types/node": "^26.6.5",
    "@vben/commitlint-config": "5.8.0",
    "@vben/eslint-config": "5.8.0",
    "@vben/oxfmt-config": "5.8.0",
    "@vben/oxlint-config": "5.8.0",
    "@vben/stylelint-config": "5.8.0",
    "@vben/tailwind-config": "5.8.0",
    "@vben/tsconfig": "5.8.0",
    "@vben/turbo-run": "5.8.0",
    "@vben/vite-config": "5.8.0",
    "@vben/vsh": "5.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "cross-env": "^10.1.0",
    "cspell": "^10.3.3",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "is-ci": "^4.1.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.63.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.5",
    "tsdown": "0.22.14",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.11",
    "vue": "3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || ^24.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "internal/*",
    "internal/lint-configs/*",
    "packages/*",
    "packages/@core/base/*",
    "packages/@core/ui-kit/*",
    "packages/@core/forward/*",
    "packages/@core/*",
    "packages/effects/*",
    "packages/business/*",
    "apps/*",
    "scripts/*",
    "docs",
    "playground"
  ],
  "overrides": {
    "@ast-grep/napi": "^0.51.0",
    "@ctrl/tinycolor": "^4.2.1",
    "clsx": "^2.1.1",
    "pinia": "^4.0.2",
    "prosemirror-view": "^1.42.6",
    "vue": "3.5.41"
  }
}
